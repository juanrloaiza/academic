---
import type { LanguageKey, TranslationKey } from "../i18n/ui";

import { getRelativeLocaleUrl } from "astro:i18n";

import { useTranslations } from "../i18n/utils";

interface Props {
  target: string;
  lang: LanguageKey;
  className: string;
}

const { target, lang, className } = Astro.props;

const targetURL = getRelativeLocaleUrl(lang, target);

const t = useTranslations(lang);

const titleKey = `${target}Title` as TranslationKey;
const titleDescription = `${target}Description` as TranslationKey;
---

<a href={targetURL} class={className}>
  <div class="hover:border-primary hover:text-primary my-3 rounded-md border-2 border-black p-3 hover:border-3 md:m-0 md:max-h-50 md:min-h-35 lg:min-h-60 dark:border-gray-100">
    <h4 class="mb-1 text-xl font-bold md:text-2xl">{t(titleKey)}</h4>
    <div class="text-lg md:text-xl">{t(titleDescription)}</div>
  </div>
</a>
