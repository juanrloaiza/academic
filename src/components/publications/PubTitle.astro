---
import { marked } from "marked";

interface Props {
    title: string;
    openaccess?: boolean;
}

const { title, openaccess } = Astro.props;

const renderedTitle = marked.parseInline(title);
---

<span set:html={renderedTitle} class="text-primary hover:text-accent" />{
    openaccess && <i class="mx-2 text-2xl text-orange-500 ai ai-open-access" />
}
