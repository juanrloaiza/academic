---
import type { BookData } from "../../types/publications";
import PubTitle from "./PubTitle.astro";

interface Props {
    book: BookData;
    className?: string;
}

const { book, className } = Astro.props;
---

<div class={className}>
    <a :href="doi ? `https://doi.org/${doi}` : url ? url : '#'">
        <PubTitle title={book.title} openaccess={book.openaccess} />
    </a>
    <div class="text-base">{book.authors} ({book.year}).</div>
    <div class="text-sm mt-0.5">
        {book.publisher && <span>{book.publisher}</span>}.
        {
            (book.doi && <a href={`https://doi.org/${book.doi}`}>doi: {book.doi}</a>) ||
                (book.url && <a href={book.url}> {book.url}</a>)
        }
    </div>
</div>
