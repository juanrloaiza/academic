---
import CVDates from "./CVDates.astro";

interface Props {
  startYear: number;
  endYear?: number;
}

const { startYear, endYear } = Astro.props;
---

<div class="mb-4 grid-cols-6 items-baseline gap-x-6 md:grid">
  <div class="col-span-2 text-base lg:col-span-1">
    <CVDates start={startYear} end={endYear} />
  </div>
  <div class="col-span-5 lg:col-span-5">
    <slot />
  </div>
</div>
