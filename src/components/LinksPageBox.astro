---
import { marked } from "marked";

interface Props {
  name: string;
  url: string;
  extra?: string;
}

const { url, name, extra } = Astro.props;

const parsedName = marked.parseInline(name);
---

<a href={url}>
  <div class="m-1 rounded-2xl border-2 border-slate-300 bg-white px-8 py-5 text-center text-lg font-semibold hover:bg-slate-300">
    <div set:html={parsedName} />
    {extra && <div class="text-sm italic">{extra}</div>}
  </div>
</a>
