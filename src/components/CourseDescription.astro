---
import type { TranslatedString } from "../i18n/ui";

import { marked } from "marked";

import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Course {
  name: TranslatedString;
  level: "pregrado" | "master" | "phd";
  description: string;
  syllabi?: Syllabus[];
}

interface Syllabus {
  route: string;
  semester: string;
}

interface Props {
  course: Course;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { course } = Astro.props;

const description = marked.parseInline(course.description);
---

<div>
  <h4 class="font-semibold">{course.name[lang]}</h4>
  <h6 class="mb-1 text-xs text-gray-500">{t(course.level)}</h6>
  <div class="my-1 flex gap-x-4 md:mt-0">
    {course.syllabi ? (
      course.syllabi.map((syllabus: Syllabus) => (
        <a
          class="text-primary/70 hover:text-accent h-fit text-sm"
          href={syllabus.route}
        >
          {syllabus.semester}
        </a>
      ))
    ) : (
      <div />
    )}
  </div>
  <div set:html={description} class="text-gray text-base" />
</div>
