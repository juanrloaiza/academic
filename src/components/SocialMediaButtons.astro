        ><i class={`ai ai-orcid ${tailwindClasses}`}></i>
    </a>
    <a href="https://www.instagram.com/loaiza.filosofia"
        ><i class={`fa-brands fa-instagram ${tailwindClasses}`}></i>
    </a>
    <a href="https://github.com/juanrloaiza"
        ><i class={`fa-brands fa-github ${tailwindClasses}`}></i>
