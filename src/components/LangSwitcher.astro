---
import { getRelativeLocaleUrl } from "astro:i18n";

import { getLangFromUrl, getPageFromUrl } from "../i18n/utils";

const page = getPageFromUrl(Astro.url);
const lang = getLangFromUrl(Astro.url);

const otherLang = lang === "en" ? "es" : "en";
---

<a
  href={getRelativeLocaleUrl(otherLang, page)}
  class="my-5 rounded-sm border-1 border-black px-3 py-1 hover:border-2 dark:border-gray-200"
>
  <span class="text-black dark:text-gray-200">{otherLang.toUpperCase()}</span>
</a>
