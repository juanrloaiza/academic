---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

import SocialMediaButtons from "../components/SocialMediaButtons.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import DarkThemeToggle from "../components/DarkThemeToggle.astro";

import "../styles/global.css";
import PageTitle from "../components/PageTitle.astro";
import SEO from "../components/SEO.astro";

interface Props {
    pageTitle?: string;
    SEOTitle?: string;
    SEODescription?: string;
}

const { pageTitle, SEOTitle, SEODescription } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.png" />

        <SEO title={SEOTitle || pageTitle} description={SEODescription} />

        <script src="https://kit.fontawesome.com/56ed2b6624.js"></script>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css"
        />
        <title>Juan R. Loaiza</title>
    </head>

    <body class="bg-background dark:bg-slate-900 dark:text-slate-100">
        <div class="max-w-6xl mx-auto pt-6 px-6">
            <div
                class="block text-center md:flex md:justify-between items-center min-h-[5rem]"
            >
                <div>
                    <a
                        href={getRelativeLocaleUrl(lang, "/")}
                        class="md:flex items-center"
                    >
                        <h1
                            class="block mb-1 md:inline md:m-0 text-4xl font-extrabold hover:text-primary"
                        >
                            Juan R. Loaiza
                        </h1>
                        <span class="text-2xl text-gray-600 dark:text-gray-400">
                            <span class="hidden md:inline mx-4"> · </span>
                            <span class="font-heading mt-1"
                                >{t("academic")}</span
                            >
                        </span>
                    </a>
                </div>

                <div class="flex items-center justify-center">
                    <div class="mx-4 justify-self-end text-lg md:text-2xl">
                        <SocialMediaButtons />
                    </div>
                    <LangSwitcher />
                    <DarkThemeToggle />
                </div>
            </div>
            <div class="mt-6 text-lg">
                <PageTitle title={pageTitle} />
                <slot />
            </div>
        </div>
    </body>
</html>
