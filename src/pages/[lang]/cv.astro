---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
    defaultStaticPathsFunction,
    getLangFromUrl,
    useTranslations,
} from "../../i18n/utils";
import CVSection from "../../components/CVSection.astro";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cv = await getCollection("cv");

const byEndYear = (a: CollectionEntry<"cv">, b: CollectionEntry<"cv">) =>
    (b.data.end_year || Infinity) - (a.data.end_year || Infinity);

const education = cv
    .filter((section) => section.data.cvtype == "education")
    .sort(byEndYear);

const employment = cv
    .filter((section) => section.data.cvtype == "employment")
    .sort(byEndYear);

const service = cv
    .filter((section) => section.data.cvtype == "service")
    .sort(byEndYear);
---

<Layout pageTitle={t("cvTitle")}>
    <h3 class="font-bold text-2xl mb-3">{t("education")}</h3>

    {
        education.map((ed) => (
            <CVSection
                startYear={ed.data.start_year}
                endYear={ed.data.end_year}
            >
                <>
                    <strong class="font-semibold">{ed.data.role[lang]}</strong>
                    <br />
                </>
                {ed.data.thesis && (
                    <span class="text-base">
                        {t("thesis")}: "{ed.data.thesis.title}"
                        <br />
                        {t("supervisors")}:{" "}
                        {ed.data.thesis.supervisors?.join(", ")}
                        <br />
                        {ed.data.thesis.examiners && (
                            <span>
                                {t("examiners")}:{" "}
                                {ed.data.thesis.examiners?.join(", ")}
                                <br />
                                {t("qualification")}:{" "}
                                {ed.data.thesis.qualification}
                            </span>
                        )}
                    </span>
                )}
            </CVSection>
        ))
    }

    <h3 class="font-bold text-2xl mb-3">{t("employment")}</h3>

    {
        employment.map((emp) => (
            <CVSection
                startYear={emp.data.start_year}
                endYear={emp.data.end_year}
            >
                <strong class="font-semibold">{emp.data.role[lang]}</strong>
                <span class="text-base">
                    <br />
                    {emp.data.faculty}, {emp.data.institution}
                </span>
            </CVSection>
        ))
    }

    <h3 class="font-bold text-2xl mb-3 mt-8">{t("service")}</h3>

    {
        service.map((srv) => (
            <CVSection
                startYear={srv.data.start_year}
                endYear={srv.data.end_year}
            >
                <strong class="font-semibold">{srv.data.role[lang]}</strong>
                <br />
                <span class="text-base">
                    {srv.data.faculty && <span>{srv.data.faculty},</span>}
                    {srv.data.institution}
                </span>
            </CVSection>
        ))
    }
</Layout>
