---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { defaultStaticPathsFunction, getLangFromUrl, useTranslations } from "../../i18n/utils";
import CourseDescription from "../../components/CourseDescription.astro";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const courses = (await getCollection("courses")).reverse();
---

<Layout pageTitle={t("teachingTitle")}>
    {courses.map((course) => <CourseDescription course={course.data} />)}
</Layout>
