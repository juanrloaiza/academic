---
import { getCollection } from "astro:content";

import {
  defaultStaticPathsFunction,
  getLangFromUrl,
  useTranslations,
} from "../../i18n/utils";

import Layout from "../../layouts/Layout.astro";
import CourseDescription from "../../components/CourseDescription.astro";
import TeachingResource from "../../components/TeachingResource.astro";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const courses = await getCollection("courses");
const sortedCourses = courses.sort((a, b) => {
  const aLatestSemester = a.data.syllabi?.length
    ? a.data.syllabi[a.data.syllabi.length - 1].semester
    : null;
  const bLatestSemester = b.data.syllabi?.length
    ? b.data.syllabi[b.data.syllabi.length - 1].semester
    : null;

  if (!aLatestSemester && !bLatestSemester) return -1;
  if (!aLatestSemester) return 1;
  if (!bLatestSemester) return -1;

  return bLatestSemester < aLatestSemester
    ? -1
    : bLatestSemester > aLatestSemester
      ? 1
      : 0; // Descending order (latest first)
});
---

<Layout pageTitle={t("teachingTitle")}>
  <div class="">
    <div class="mb-8">
      <h3 class="font-bold text-2xl md:mb-3">Recursos docentes</h3>

      <div class="flex flex-col md:grid grid-cols-3 gap-4">
        <TeachingResource
          href="/public/Loaiza_ManualParaTesistas_v1.0.pdf"
          title="Manual para tesistas"
        >
          Documento con instrucciones, consejos y expectativas para estudiantes
          que quieren hacer su conmigo.
        </TeachingResource>

        <TeachingResource
          href="/public/Loaiza_GuiaParaAbstracts.pdf"
          title="¿Cómo escribir un resumen para un artículo académico en filosofía?"
        >
          Guía para escribir resúmenes de artículos o charlas en filosofía.
        </TeachingResource>
      </div>
    </div>

    <div class="">
      <h3 class="font-bold text-2xl mb-2">{t("courses")}</h3>
      <div class="flex flex-col md:grid grid-cols-2 gap-y-6">
        {sortedCourses.map((course) => (
          <CourseDescription course={course.data} />
        ))}
      </div>
    </div>
  </div>
</Layout>
