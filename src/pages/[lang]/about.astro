---
import { getEntry, render } from "astro:content";

import AcademicPhoto from "../../components/AcademicPhoto.astro";
import Layout from "../../layouts/Layout.astro";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { defaultStaticPathsFunction } from "../../utils/getStaticPaths";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const entry = await getEntry("about", lang);
const { Content } = entry ? await render(entry) : {};
const { competence, specialization } = entry
  ? await entry.data.areas
  : { competence: [], specialization: [] };
---

<Layout pageTitle={t("aboutTitle")}>
  <div class="gap-y-6 md:grid md:grid-cols-4 md:gap-x-7 lg:gap-x-15">
    <AcademicPhoto className="mx-auto my-6 w-2/3 md:my-0 md:w-full" />

    <div class="md-content col-span-3">{Content && <Content />}</div>

    <div class="col-span-3 col-start-2 md:flex md:gap-x-6 lg:justify-around">
      <div class="my-6 md:my-0 md:w-1/2 lg:my-6 lg:w-1/3">
        <h4 class="font-bold">{t("specialization")}</h4>

        <ul class="list-disc pl-4">
          {specialization.map((area) => (
            <li>{area}</li>
          ))}
        </ul>
      </div>
      <div class="my-6 md:my-0 md:w-1/2 lg:my-6 lg:w-1/3">
        <h4 class="font-bold">{t("competence")}</h4>

        <ul class="list-disc pl-4">
          {competence.map((area) => (
            <li>{area}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Layout>
