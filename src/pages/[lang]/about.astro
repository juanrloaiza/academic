---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

import {
    getLangFromUrl,
    useTranslations,
    defaultStaticPathsFunction,
} from "../../i18n/utils";

import { Image } from "astro:assets";
import academicPhoto from "../../assets/academic.png";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const entry = await getEntry("about", lang);
const { Content } = entry ? await render(entry) : {};
const { competence, specialization } = entry
    ? await entry.data.areas
    : { competence: [], specialization: [] };
---

<Layout pageTitle={t("aboutTitle")}>
    <div class="md:grid md:grid-cols-4 md:gap-x-7 lg:gap-x-15 gap-y-6">
        <Image
            class="mx-auto w-2/3 my-6 md:my-0 md:w-full"
            src={academicPhoto}
            alt="Photo of Juan R. Loaiza"
        />

        <div class="col-span-3 md-content">
            {Content && <Content />}
        </div>

        <div
            class="md:flex md:gap-x-6 col-span-3 col-start-2 lg:justify-around"
        >
            <div class="my-6 md:my-0 md:w-1/2 lg:w-1/3 lg:my-6">
                <h4 class="font-bold">{t("specialization")}</h4>

                <ul class="list-disc pl-4">
                    {specialization.map((area) => <li>{area}</li>)}
                </ul>
            </div>
            <div class="my-6 md:my-0 md:w-1/2 lg:w-1/3 lg:my-6">
                <h4 class="font-bold">{t("competence")}</h4>

                <ul class="list-disc pl-4">
                    {competence.map((area) => <li>{area}</li>)}
                </ul>
            </div>
        </div>
    </div>
</Layout>
