---
import BentoBox from "../../components/BentoBox.astro";
import Layout from "../../layouts/Layout.astro";

import { getLangFromUrl } from "../../i18n/utils";
import { defaultStaticPathsFunction } from "../../utils/getStaticPaths";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);

const links = [
  { target: "about", span: "col-span-3" },
  { target: "cv", span: "col-span-5" },
  { target: "pubs", span: "col-span-4" },
  { target: "blog", span: "col-span-4" },
  { target: "teaching", span: "col-span-3" },
  { target: "other", span: "col-span-5" },
];
---

<Layout>
  <div class="flex min-h-[60vh] items-center lg:min-h-[80vh]">
    <div class="lg:h-60vh grid-flow-dense gap-4 md:my-6 md:grid md:grid-cols-8 lg:grid-cols-12">
      {links.map((link) => (
        <BentoBox className=`${link.span}` target={link.target} lang={lang} />
      ))}
    </div>
  </div>
</Layout>
