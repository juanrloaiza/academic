---
import Layout from "../../layouts/Layout.astro";

import { defaultStaticPathsFunction, getLangFromUrl } from "../../i18n/utils";

import BentoBox from "../../components/BentoBox.astro";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
---

<Layout>
    <div class="min-h-[60vh] lg:min-h-[80vh] flex items-center">
        <div
            class="lg:h-60vh md:my-6 md:grid md:grid-cols-8 lg:grid-cols-12 grid-flow-dense gap-4"
        >
            <BentoBox
                class="col-span-3 row-span-1 lg:col-span-3 lg:row-span-1"
                target="about"
                lang={lang}
            />
            <BentoBox
                class="col-span-5 row-span-1 lg:col-span-4 lg:row-span-1"
                target="cv"
                lang={lang}
            />
            <BentoBox
                class="col-span-4 row-span-1 lg:col-span-5 lg:row-span-1"
                target="pubs"
                lang={lang}
            />
            <BentoBox
                class="col-span-4 row-span-1 lg:col-span-4 lg:row-span-1"
                target="blog"
                lang={lang}
            />
            <BentoBox
                class="col-span-3 row-span-1 lg:col-span-4 lg:row-span-1"
                target="teaching"
                lang={lang}
            />
            <BentoBox
                class="col-span-5 row-span-1 lg:col-span-4 lg:row-span-1"
                target="other"
                lang={lang}
            />
        </div>
    </div>
</Layout>
