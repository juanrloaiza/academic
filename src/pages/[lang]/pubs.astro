---
import type {
  ArticleData,
  BookChapterData,
  BookData,
} from "../../data/publications/publicationSchemas";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

import Layout from "../../layouts/Layout.astro";
import Article from "../../components/publications/Article.astro";
import Book from "../../components/publications/Book.astro";
import BookChapter from "../../components/publications/BookChapter.astro";

import { getPublicationCollections } from "../../data/publications/publicationSchemas";
import { defaultStaticPathsFunction } from "../../utils/getStaticPaths";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get pub collections

const { articles, comments, bookChapters, books } =
  await getPublicationCollections();
---

<Layout pageTitle={t("pubsTitle")}>
  <h3 class="text-2xl font-bold mt-6 mb-2">{t("articles")}</h3>
  {articles.map((article) => (
    <Article article={article.data as ArticleData} className="mb-4 md:mb-3" />
  ))}

  <h3 class="text-2xl font-bold mt-6 mb-4 md:mb-2">{t("comments")}</h3>
  {comments.map((comment) => (
    <Article article={comment.data as ArticleData} className="mb-4 md:mb-3" />
  ))}

  <h3 class="text-2xl font-bold mt-6 mb-4 md:mb-2">{t("bookchapters")}</h3>
  {bookChapters.map((bookChapter) => (
    <BookChapter
      bookChapter={bookChapter.data as BookChapterData}
      className="mb-4 md:mb-3"
    />
  ))}
  <h3 class="text-2xl font-bold mt-6 mb-4 md:mb-2">{t("monographs")}</h3>

  {books.map((book) => (
    <Book book={book.data as BookData} className="mb-4 md:mb-3" />
  ))}
</Layout>
