---
import { getCollection } from "astro:content";
import { marked } from "marked";

import Tag from "../../../components/Tag.astro";
import Layout from "../../../layouts/Layout.astro";

import { getLangFromUrl } from "../../../i18n/utils";
import { defaultStaticPathsFunction } from "../../../utils/getStaticPaths";

export const getStaticPaths = defaultStaticPathsFunction;

const blogEntries = await getCollection("blog");

const blogsByYear = blogEntries.reduce(
  (acc, currentEntry) => {
    const year = new Date(currentEntry.data.date).getFullYear();

    if (!acc[year]) acc[year] = [];
    acc[year].unshift(currentEntry);

    return acc;
  },
  {} as Record<string, typeof blogEntries>,
);

const years = Object.keys(blogsByYear).sort((a, b) => Number(b) - Number(a));

const SEODescription = {
  en: "Juan R. Loaiza's Blog",
  es: "Blog de Juan R. Loaiza",
};

const lang = getLangFromUrl(Astro.url);
---

<Layout pageTitle="Blog" SEODescription={SEODescription[lang]}>
  {years.map((year) => (
    <div class="blog-list grid-cols-12 items-baseline gap-x-4 md:grid">
      <div class="col-span-1 mb-2 text-xl font-semibold md:text-sm md:font-normal">
        {year}
      </div>
      <div class="col-span-11">
        {blogsByYear[year].map(
          (entry) =>
            !entry.data.draft && (
              <div class="mb-6">
                <a
                  href={`${year}/${entry.data.slug}`}
                  class="text-primary hover:text-accent"
                  set:html={marked.parseInline(entry.data.title)}
                />
                {entry.data.summary && (
                  <div
                    v-if="post.summary"
                    class="text-base"
                    set:html={marked.parseInline(entry.data.summary)}
                  />
                )}
                <div class="mt-2 flex">
                  {entry.data.tags &&
                    entry.data.tags.map((tag) => <Tag>{tag}</Tag>)}
                </div>
              </div>
            ),
        )}
      </div>
    </div>
  ))}
</Layout>
