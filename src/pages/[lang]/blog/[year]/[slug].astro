---
import { render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import { marked } from "marked";

import Tag from "../../../../components/Tag.astro";
import Layout from "../../../../layouts/Layout.astro";

import { getLangFromUrl, useTranslations } from "../../../../i18n/utils";
import { getBlogStaticPaths } from "../../../../utils/getStaticPaths";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export const getStaticPaths = getBlogStaticPaths;

const formatDate = (dateString: string) =>
  dayjs(dateString).format("YYYY.MM.DD");

const { entry } = Astro.props;
const { Content } = await render(entry);

const renderedTitle = marked.parseInline(entry.data.title);
---

<Layout
  SEOTitle={`${entry.data.title} — Blog`}
  SEODescription={entry.data.summary}
>
  <div class="mx-auto max-w-[70ch]">
    <a
      href={getRelativeLocaleUrl(lang, "blog")}
      class="my-4 mr-3 block text-sm text-gray-500"
    >
      <i class="fa-solid fa-arrow-left"></i>
      {t("backblog")}
    </a>
    <h2 class="mb-5 text-3xl font-bold" set:html={renderedTitle} />

    <div class="mb-10 flex items-baseline">
      <div class="mr-4 text-base">{formatDate(entry.data.date)}</div>
      <div class="mt-2 flex">
        {entry.data.tags && entry.data.tags.map((tag) => <Tag>{tag}</Tag>)}
      </div>
    </div>

    <div class="blog-content">
      <Content />
    </div>
  </div>
</Layout>
