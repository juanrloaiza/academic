---
import { getEntry, render } from "astro:content";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { defaultStaticPathsFunction } from "../../utils/getStaticPaths";

import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = defaultStaticPathsFunction;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const entry = await getEntry("other", lang);

const { Content } = entry ? await render(entry) : {};
---

<Layout pageTitle={t("otherTitle")}>
  <div class="md-content">{Content && <Content />}</div>
</Layout>
