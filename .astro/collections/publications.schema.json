            "article",
            "book",
            "bookchapter",
            "comment"
          ]
        },
        "year": {
          "type": [
            "number",
            "string"
          ]
        },
        "journal": {
          "type": "string"
        },
        "volume": {
          "type": "number"
        },
        "issue": {
          "type": [
            "number",
            "string"
          ]
        },
        "booktitle": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "isbn": {
          "type": "number"
        },
        "editors": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "openaccess": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "pages": {
          "type": "string",
          "pattern": "^\\d+\\-\\d+"
        },
        "abstract": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
